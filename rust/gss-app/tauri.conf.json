{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Google Scholar Scraper",
  "version": "3.2.0",
  "identifier": "com.googlescholarscraper.app",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Google Scholar Scraper v3.2.0",
        "width": 1080,
        "height": 700,
        "minWidth": 860,
        "minHeight": 560,
        "resizable": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ]
  }
}
